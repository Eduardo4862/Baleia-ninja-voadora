{
  "manifest_version": 3,
  "name": "Baleia ninja voadora",
  "version": "1.1.2",
  "description": "Uma extensão divertida que adiciona uma baleia animada ao seu navegador.",
  "permissions": [
    "activeTab",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Baleia Ninja Voadora",
    "default_icons": {
      "16": "images/baleiamini.png",
      "48": "images/baleiamini.png",
      "128": "images/baleiamini.png"
    }
  },
  "icons": {
    "16": "images/baleiamini.png",
    "48": "images/baleiamini.png",
    "128": "images/baleiamini.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["images/baleiamini.png", "images/gremio.png", "images/baleiaminigremio.png"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
